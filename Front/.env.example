# URL privada del backend, también usada por el proxy /api del frontend.
API_URL=http://127.0.0.1:4002/api

# Clave pública de Mercado Pago; nunca colocar aquí el access token.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# URL pública de la carpeta con las imágenes del formulario, sin barra final.
NEXT_PUBLIC_CLOUDINARY_FORMULARIO_BASE_URL=

# Variables privadas para el formulario de contacto en Next.js.
RESEND_API_KEY=
MAIL_FROM=
CONTACT_EMAIL=
